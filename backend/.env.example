# Comma-separated list of allowed origins (localhost is already allowed by default)
CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

# Server environment mode (development or production)
ENVIRONMENT=production

# Header set by the proxy in front of this server, such as cf-connecting-ip or x-real-ip.
# Required behind a proxy, or every device lands in the same discovery room.
# Leave empty only if clients connect directly to this server.
TRUSTED_PROXY_HEADER=
